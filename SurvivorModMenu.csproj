<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AssemblyName>SurvivorModMenu</AssemblyName>
        <RootNamespace>SurvivorModMenu</RootNamespace>
        <VSDir>/mnt/data/SteamLibrary/steamapps/common/VSModded</VSDir>
        <Net6>$(VSDir)/MelonLoader/net6</Net6>
        <Il2>$(VSDir)/MelonLoader/Il2CppAssemblies</Il2>
        <DisablePluginDeploy>false</DisablePluginDeploy>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Il2CppPauseSystem">
            <HintPath>$(Il2)/Il2CppPauseSystem.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppPhaserPort">
            <HintPath>$(Il2)/Il2CppPhaserPort.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.AssetBundleModule">
            <HintPath>$(Il2)/UnityEngine.AssetBundleModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(Il2)/UnityEngine.CoreModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.ImageConversionModule">
            <HintPath>$(Il2)/UnityEngine.ImageConversionModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.InputLegacyModule">
            <HintPath>$(Il2)/UnityEngine.InputLegacyModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.UIModule">
            <HintPath>$(Il2)/UnityEngine.UIModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(Il2)/UnityEngine.UI.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(Il2)/UnityEngine.TextRenderingModule.dll</HintPath>
        </Reference>
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(Il2)/Unity.TextMeshPro.dll</HintPath>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(Net6)/0Harmony.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppVampireSurvivors">
            <HintPath>$(Il2)/Il2CppVampireSurvivors.Runtime.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppInterop.Runtime">
            <HintPath>$(Net6)/Il2CppInterop.Runtime.dll</HintPath>
        </Reference>
        <Reference Include="MelonLoader">
            <HintPath>$(Net6)/MelonLoader.dll</HintPath>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(Net6)/Newtonsoft.Json.dll</HintPath>
        </Reference>
        <Reference Include="Il2Cppmscorlib">
            <HintPath>$(Il2)/Il2Cppmscorlib.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppNewtonsoft.Json">
            <HintPath>$(Il2)/Il2CppNewtonsoft.Json.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppRewired_CSharp">
            <HintPath>$(Il2)/Il2CppRewired_CSharp.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppRewired_Core">
            <HintPath>$(Il2)/Il2CppRewired_Core.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppRewired_UnityUI_CSharp">
            <HintPath>$(Il2)/Il2CppRewired_UnityUI_CSharp.dll</HintPath>
        </Reference>
        <Reference Include="FixNullableAttribute">
            <HintPath>/mnt/data/SteamLibrary/steamapps/common/VSModded/UserLibs/FixNullableAttribute.dll</HintPath>
        </Reference>
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="Build" Condition="'$(DisablePluginDeploy)' != 'true'">
        <Copy
            SourceFiles="$(TargetPath)"
            DestinationFolder="$(VSDir)/Plugins"
        />
    </Target>

</Project>
